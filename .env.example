# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (development default)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://user:password@localhost:5432/fristvakt"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Inbound Email ────────────────────────────────────────────────────────────
# Domain where inbound emails are received (e.g. inbound.yourdomain.com)
INBOUND_DOMAIN="inbound.fristvakt.no"

# Email provider: "sendgrid" or "mailgun"
EMAIL_PROVIDER="sendgrid"

# SendGrid Inbound Parse webhook secret (optional, for signature verification)
SENDGRID_WEBHOOK_SECRET=""

# Mailgun webhook signing key (optional, for signature verification)
MAILGUN_WEBHOOK_SECRET=""

# ─── Outbound Email (SMTP) ────────────────────────────────────────────────────
# If not set, emails are logged to console in development
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Fristvakt <noreply@fristvakt.no>"

# ─── Cron Job ────────────────────────────────────────────────────────────────
# Secret to protect the cron endpoint. Leave empty to disable auth.
CRON_SECRET="your-cron-secret"
